{
  "name": "ai-tech-news-automation",
  "private": true,
  "version": "0.2.0",
  "description": "Skill-driven Remotion vertical motion study",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "sound": "node scripts/make-sound.cjs",
    "render": "npm run sound && remotion render src/index.ts TechNewsPreview out/sample.mp4 --codec h264 --crf 20 --concurrency 2",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "remotion": "4.0.538",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1"
  }
}
